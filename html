/* =========================
   RESET
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f5f7fb;
    color: #172033;
    line-height: 1.6;
}

a {
    text-decoration: none;
    color: inherit;
}

button,
input,
select,
textarea {
    font-family: inherit;
}


/* =========================
   CONTAINER
========================= */

.container {
    width: 90%;
    max-width: 1200px;
    margin: auto;
}


/* =========================
   NAVIGATION
========================= */

header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: white;
    box-shadow: 0 2px 15px rgba(0,0,0,0.08);
}

.navbar {
    min-height: 75px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 27px;
    font-weight: 800;
    color: #0b5cff;
}

.logo span {
    color: #172033;
}

.nav-links {
    display: flex;
    gap: 28px;
    list-style: none;
}

.nav-links a {
    font-weight: 600;
    transition: 0.3s;
}

.nav-links a:hover {
    color: #0b5cff;
}

.menu-btn {
    display: none;
    font-size: 32px;
    cursor: pointer;
}


/* =========================
   HERO
========================= */

.hero {
    min-height: 650px;

    display: flex;
    align-items: center;

    background:
        linear-gradient(
            rgba(4,17,38,0.78),
            rgba(4,17,38,0.78)
        ),
        url("https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1600&q=80")
        center/cover;

    color: white;
}

.hero-content {
    max-width: 760px;
}

.hero-small {
    font-weight: bold;
    letter-spacing: 2px;
    margin-bottom: 15px;
}

.hero h1 {
    font-size: clamp(42px, 7vw, 75px);
    line-height: 1.05;
    margin-bottom: 22px;
}

.hero h1 span {
    color: #4e8cff;
}

.hero p {
    font-size: 19px;
    max-width: 650px;
    margin-bottom: 30px;
}


/* =========================
   BUTTONS
========================= */

.btn {
    display: inline-block;
    padding: 14px 25px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-weight: bold;
    font-size: 16px;
    transition: 0.3s;
}

.btn-primary {
    background: #0b5cff;
    color: white;
}

.btn-primary:hover {
    background: #0646c9;
    transform: translateY(-2px);
}

.btn-light {
    background: white;
    color: #172033;
    margin-left: 10px;
}

.btn-light:hover {
    background: #eeeeee;
}


/* =========================
   SEARCH BOX
========================= */

.search-box {
    background: white;
    margin-top: -55px;
    position: relative;
    z-index: 10;

    padding: 28px;

    border-radius: 18px;

    box-shadow:
        0 15px 40px rgba(0,0,0,0.12);
}

.search-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 0.8fr;
    gap: 15px;
}

.search-grid input,
.search-grid select {
    width: 100%;
    padding: 16px;

    border: 2px solid #e2e2e2;
    border-radius: 10px;

    outline: none;
    background: #fff;

    font-size: 16px;
}

.search-grid input:focus,
.search-grid select:focus {
    border-color: #0b5cff;
}

.search-grid button {
    width: 100%;
}

#searchResult {
    margin-top: 18px;
    text-align: center;
    font-weight: bold;
    color: #0b5cff;
}


/* =========================
   SECTIONS
========================= */

section {
    padding: 80px 0;
}

.section-title {
    text-align: center;
    margin-bottom: 45px;
}

.section-title h2 {
    font-size: 40px;
    margin-bottom: 10px;
}

.section-title p {
    color: #687386;
    font-size: 17px;
}


/* =========================
   SERVICES
========================= */

.services {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 25px;
}

.service {
    background: white;
    padding: 35px 25px;

    border-radius: 15px;

    text-align: center;

    box-shadow: 0 5px 20px rgba(0,0,0,0.06);

    transition: 0.3s;
}

.service:hover {
    transform: translateY(-8px);
}

.service-icon {
    font-size: 48px;
    margin-bottom: 15px;
}

.service h3 {
    margin-bottom: 10px;
    font-size: 22px;
}

.service p {
    color: #687386;
}


/* =========================
   PROPERTIES
========================= */

.properties {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 25px;
}

.property {
    background: white;

    border-radius: 15px;

    overflow: hidden;

    box-shadow: 0 5px 20px rgba(0,0,0,0.07);

    transition: 0.3s;
}

.property:hover {
    transform: translateY(-7px);
}

.property-img {
    width: 100%;
    height: 230px;
    object-fit: cover;
}

.property-info {
    padding: 22px;
}

.property-info h3 {
    font-size: 21px;
    margin-bottom: 8px;
}

.location {
    color: #687386;
    margin-bottom: 12px;
}

.price {
    color: #0b5cff;
    font-size: 22px;
    font-weight: bold;
}

.property-details {
    display: flex;
    justify-content: space-between;

    border-top: 1px solid #eee;

    margin-top: 15px;
    padding-top: 15px;

    color: #555;
    font-size: 14px;
}

.property-btn {
    display: block;

    text-align: center;

    background: #0b5cff;
    color: white;

    padding: 12px;

    border-radius: 8px;

    margin-top: 18px;
}

.property-btn:hover {
    background: #0646c9;
}


/* =========================
   NO RESULTS
========================= */

.no-results {
    display: none;

    text-align: center;

    padding: 40px;

    color: #687386;
}

.no-results h3 {
    font-size: 25px;
    margin-bottom: 8px;
}


/* =========================
   ABOUT
========================= */

.about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;

    align-items: center;
}

.about img {
    width: 100%;

    border-radius: 18px;
}

.about h2 {
    font-size: 42px;
    margin-bottom: 20px;
}

.about p {
    color: #687386;
    margin-bottom: 18px;
}

.about-list {
    list-style: none;
    margin: 20px 0;
}

.about-list li {
    margin-bottom: 12px;
    font-weight: 600;
}


/* =========================
   STATS
========================= */

.stats {
    background: #0b5cff;
    color: white;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 20px;

    text-align: center;
}

.stat h3 {
    font-size: 40px;
}

.stat p {
    opacity: 0.9;
}


/* =========================
   TESTIMONIALS
========================= */

.testimonials {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 25px;
}

.testimonial {
    background: white;

    padding: 30px;

    border-radius: 15px;

    box-shadow: 0 5px 20px rgba(0,0,0,0.06);
}

.stars {
    color: #f5a623;
    font-size: 20px;
    margin-bottom: 15px;
}


/* =========================
   CONTACT
========================= */

.contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
}

.contact-box {
    background: white;

    padding: 30px;

    border-radius: 15px;

    box-shadow: 0 5px 20px rgba(0,0,0,0.06);
}

.contact-box h3 {
    font-size: 25px;
    margin-bottom: 20px;
}

.contact-item {
    margin-bottom: 22px;
}

.contact-item strong {
    display: block;
    margin-bottom: 5px;
}

.contact-item p {
    color: #687386;
}

.contact-form input,
.contact-form select,
.contact-form textarea {
    width: 100%;

    padding: 15px;

    margin-bottom: 15px;

    border: 1px solid #ddd;

    border-radius: 8px;

    outline: none;

    font-size: 16px;
}

.contact-form input:focus,
.contact-form select:focus,
.contact-form textarea:focus {
    border-color: #0b5cff;
}

.contact-form textarea {
    height: 130px;
    resize: none;
}

.contact-form button {
    width: 100%;
}

.map {
    width: 100%;
    height: 300px;

    border: 0;

    border-radius: 12px;

    margin-top: 15px;
}


/* =========================
   FOOTER
========================= */

footer {
    background: #101827;
    color: white;

    padding: 60px 0 25px;
}

.footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;

    gap: 35px;
}

.footer-grid h3 {
    margin-bottom: 18px;
}

.footer-grid p {
    color: #aab4c5;
}

.footer-links {
    list-style: none;
}

.footer-links li {
    margin-bottom: 10px;
    color: #aab4c5;
}

.footer-links a:hover {
