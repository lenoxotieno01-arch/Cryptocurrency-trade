.footer-bottom {
    border-top: 1px solid #293344;

    margin-top: 40px;

    padding-top: 20px;

    text-align: center;

    color: #9aa5b5;
}


/* =========================
   WHATSAPP
========================= */

.whatsapp {
    position: fixed;

    right: 20px;
    bottom: 20px;

    width: 60px;
    height: 60px;

    background: #25d366;

    color: white;

    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 29px;

    z-index: 999;

    box-shadow: 0 5px 20px rgba(0,0,0,0.25);
}


/* =========================
   MODAL
========================= */

.modal {
    display: none;

    position: fixed;

    inset: 0;

    background: rgba(0,0,0,0.72);

    z-index: 2000;

    align-items: center;
    justify-content: center;

    padding: 20px;
}

.modal-content {
    background: white;

    width: 100%;
    max-width: 550px;

    border-radius: 16px;

    padding: 35px;

    position: relative;
}

.close {
    position: absolute;

    right: 20px;
    top: 15px;

    font-size: 30px;

    cursor: pointer;
}

.modal-content h2 {
    margin-bottom: 10px;
}

.modal-location {
    color: #687386;
}

.modal-price {
    color: #0b5cff;

    font-size: 25px;

    font-weight: bold;
}


/* =========================
   MOBILE
========================= */

@media(max-width: 900px) {

    .nav-links {
        position: absolute;

        top: 75px;
        left: 0;

        width: 100%;

        background: white;

        display: none;

        flex-direction: column;

        padding: 25px;

        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .nav-links.active {
        display: flex;
    }

    .menu-btn {
        display: block;
    }

    .search-grid {
        grid-template-columns: 1fr 1fr;
    }

    .services,
    .properties,
    .testimonials {
        grid-template-columns: 1fr 1fr;
    }

    .about,
    .contact {
        grid-template-columns: 1fr;
    }

    .footer-grid {
        grid-template-columns: 1fr 1fr;
    }

    .stats-grid {
        grid-template-columns: 1fr 1fr;
    }
}


@media(max-width: 600px) {

    .container {
        width: 92%;
    }

    section {
        padding: 60px 0;
    }

    .hero {
        min-height: 590px;
    }

    .hero h1 {
        font-size: 45px;
    }

    .hero p {
        font-size: 16px;
    }

    .btn {
        display: block;

        width: 100%;

        text-align: center;

        margin: 10px 0;
    }

    .btn-light {
        margin-left: 0;
    }

    .search-grid {
        grid-template-columns: 1fr;
    }

    .services,
    .properties,
    .testimonials {
        grid-template-columns: 1fr;
    }

    .stats-grid {
        grid-template-columns: 1fr 1fr;
    }

    .footer-grid {
        grid-template-columns: 1fr;
    }

    .section-title h2 {
        font-size: 32px;
    }

    .about h2 {
        font-size: 34px;
    }

}

</style>
</head>


